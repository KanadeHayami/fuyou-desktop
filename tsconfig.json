{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "jsxImportSource": "preact", "strict": true,
    "esModuleInterop": true, "resolveJsonModule": true, "allowJs": true,
    "skipLibCheck": true, "types": ["node", "vite/client"], "noEmit": true
  },
  "include": ["src", "tests", "*.ts", "scripts/data-lib.mjs"]
}
